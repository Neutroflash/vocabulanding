# Copia este archivo a .env.local y completa los valores.

# Postgres local (docker compose up -d) o la cadena "pooled" de Neon en producción.
DATABASE_URL=postgres://vocabulanding:vocabulanding@localhost:5433/vocabulanding

# Clave para firmar la sesión. Genera una con: openssl rand -base64 32
SESSION_SECRET=

# Cuenta docente que crea `npm run db:seed`.
TEACHER_USERNAME=profesora
TEACHER_NAME=Profesora
TEACHER_PASSWORD=
